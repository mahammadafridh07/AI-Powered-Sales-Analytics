# ---------------------------------------------------------------------------
# Database
# For local development SQLite works out of the box (no setup required):
DATABASE_URL=sqlite:///./sales_analytics.db
# For production, use PostgreSQL, e.g.:
# DATABASE_URL=postgresql://username:password@host:5432/sales_analytics

# ---------------------------------------------------------------------------
# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# AI / LLM integration (optional).
# The app works fully without this -- the AI Analyst & AI Insights features
# will show a clear "not configured" message instead of crashing.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_PROVIDER=anthropic

# ---------------------------------------------------------------------------
# CORS / URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Uploads
MAX_UPLOAD_SIZE_MB=25
